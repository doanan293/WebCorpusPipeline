<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram name="Thuật toán tìm khối nội dung" id="thuat-toan-khoi-noi-dung"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="44" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Mã HTML của trang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="300" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Đọc cấu trúc trang bằng lxml, bỏ phần không&lt;br&gt;phải nội dung: menu, đầu trang, chân trang…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="300" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Trang có thẻ&lt;br&gt;&amp;lt;article&amp;gt; hoặc&lt;br&gt;&amp;lt;main&amp;gt; đánh dấu&lt;br&gt;vùng bài viết?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="190" width="240" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Tìm các vùng có tên gợi ý nội dung như&lt;br&gt;content, news, post, detail; bỏ vùng là&lt;br&gt;menu, thanh bên, bình luận, chia sẻ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="205" width="300" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Chấm điểm từng vùng: &lt;b&gt;nhiều chữ, nhiều đoạn văn&lt;/b&gt;&lt;br&gt;thì điểm cao; &lt;b&gt;nhiều chữ nằm trong liên kết&lt;/b&gt;&lt;br&gt;như menu, danh sách tin thì bị trừ điểm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="380" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Vùng điểm cao nhất&lt;br&gt;có ít nhất 40 ký tự?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="450" width="240" height="110" as="geometry"/></mxCell><mxCell id="c9" value="Lấy cả trang làm nội dung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="475" width="300" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Vùng nội dung chính&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="300" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Lấy thông tin từ vùng nội dung&lt;/b&gt;&lt;br&gt;• Tiêu đề: tiêu đề lớn trong bài, không có thì&lt;br&gt;lấy tiêu đề của trang&lt;br&gt;• Ngày đăng, tác giả: thông tin trang khai báo&lt;br&gt;• Nội dung: đoạn văn, danh sách, bảng&lt;br&gt;• Ảnh trong bài, các liên kết đi ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="380" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Văn bản mô tả liên kết&lt;/b&gt;, lưu vào graph&lt;br&gt;Liên kết nằm giữa đoạn văn:&lt;br&gt;lấy nguyên &lt;b&gt;câu chứa liên kết&lt;/b&gt;.&lt;br&gt;Liên kết đứng riêng như menu, số trang,&lt;br&gt;hoặc câu quá dài: lấy chữ của liên kết." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="300" height="150" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="có: xét các vùng đó" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="380"/></Array></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="625"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
