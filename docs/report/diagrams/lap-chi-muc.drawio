<mxfile host="drawio" version="26.0.0"><diagram name="cm" id="cm"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cm1" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="cm2" value="Lập chỉ mục và đồng bộ một bản ghi từ MongoDB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="cm3" value="Bản ghi trang hoặc tệp: khi lập toàn bộ,&lt;br&gt;hoặc khi đồng bộ vì vừa được cập nhật" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="400" height="60" as="geometry"/></mxCell><mxCell id="cm4" value="Trang trùng nội dung&lt;br&gt;hoặc rỗng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="cm5" value="Không đưa vào chỉ mục;&lt;br&gt;nếu đã có thì xoá bản cũ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="300" height="60" as="geometry"/></mxCell><mxCell id="cm6" value="Tệp tài liệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="cm7" value="Gom