<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram name="merger" id="merger"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Merger: phát hiện thay đổi, loại trùng, lọc liên kết" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Nhận bản ghi từ Reader" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Máy chủ báo&lt;br&gt;trang chưa đổi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="So dấu vân tay&lt;br&gt;với lần tải trước" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="265" width="200" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Không đổi&lt;/b&gt;: giống lần trước, lần này&lt;br&gt;không đọc được gì, hoặc máy chủ&lt;br&gt;báo chưa đổi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="270" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Storage chỉ ghi thời điểm kiểm tra;&lt;br&gt;&lt;b&gt;không&lt;/b&gt; đi tiếp các liên kết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="270" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Trang mới&lt;/b&gt; hoặc &lt;b&gt;đã thay đổi&lt;/b&gt;:&lt;br&gt;ghi nhớ dấu vân tay mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="300" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Tính mã băm của nội dung trang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="490" width="300" height="60" as="geometry"/></mxCell><mxCell id="c11" value="Nội dung này&lt;br&gt;đã có ở&lt;br&gt;trang khác?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="200" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Trùng nội dung&lt;/b&gt;: chỉ lưu bản rút gọn&lt;br&gt;trỏ về trang gốc, không đi tiếp liên kết&lt;br&gt;để tránh lặp vô hạn kiểu ?page=1, 2, 3…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="590" width="300" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Storage lưu bản ghi đầy đủ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="710" width="300" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Lọc liên kết đi ra&lt;/b&gt;&lt;br&gt;① Bỏ link đăng nhập, đăng ký, in, chia sẻ&lt;br&gt;② Bỏ trang tìm kiếm, bộ lọc, lịch,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lưu trữ theo ngày&lt;br&gt;③ Bỏ ảnh, video; chỉ giữ trang và tài liệu&lt;br&gt;④ Bỏ phần thừa của URL như #, mã theo dõi&lt;br&gt;⑤ Chỉ giữ link thuộc 77 website của trường&lt;br&gt;⑥ Bỏ link đã biết từ trước" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="790" width="300" height="200" as="geometry"/></mxCell><mxCell id="c15" value="Gom thành nhóm 500 URL,&lt;br&gt;hoặc gửi sau mỗi 1 giây" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1050" width="300" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Gửi URL mới sang Mediator" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1140" width="300" height="50" as="geometry"/></mxCell><mxCell id="c17" value="Sau mỗi lần tải: báo Mediator&lt;br&gt;trang mới, đã đổi hay không đổi&lt;br&gt;để chỉnh lịch tải lại" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="275" width="300" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Không mất dữ liệu khi gửi lỗi&lt;/b&gt;&lt;br&gt;Gửi sang Storage hoặc Mediator&lt;br&gt;thất bại thì ghi tạm ra tệp&lt;br&gt;và gửi lại sau." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="790" width="300" height="130" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Bộ nhớ SQLite&lt;/b&gt;&lt;br&gt;của Merger&lt;br&gt;URL đã biết&lt;br&gt;trang gốc của mỗi nội dung&lt;br&gt;dấu vân tay từng trang" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="230" height="120" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#B91C1C;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="185"/></Array></mxGeometry></mxCell><mxCell id="c23" value="giống" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#B91C1C;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="mới / khác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#16A34A;fontColor=#15803D;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#B91C1C;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#16A34A;fontColor=#15803D;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=none;strokeColor=#64748B;strokeWidth=1;" edge="1" parent="1" source="c19" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
