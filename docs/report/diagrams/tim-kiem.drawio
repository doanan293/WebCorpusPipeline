<mxfile host="drawio" version="26.0.0"><diagram name="tk" id="tk"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk1" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="tk2" value="Xử lý một truy vấn tìm kiếm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="tk3" value="Người dùng nhập truy vấn" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="66" width="300" height="56" as="geometry"/></mxCell><mxCell id="tk4" value="Có toán tử, ngoặc kép&lt;br&gt;hoặc ký tự đại diện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="200" height="100" as="geometry"/></mxCell><mxCell id="tk5" value="Phân tích theo cú pháp Lucene trên tiêu đề,&lt;br&gt;văn bản liên kết và nội dung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="330" height="60" as="geometry"/></mxCell><mxCell id="tk6" value="Tiền xử lý như lúc lập chỉ mục; khớp nguyên&lt;br&gt;cụm âm tiết là chính, khớp từ ghép là phụ;&lt;br&gt;tiêu đề nặng nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="3