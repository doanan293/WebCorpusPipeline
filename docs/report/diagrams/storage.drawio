<mxfile host="drawio" version="26.0.0"><diagram name="storage" id="storage"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Storage: ghi MongoDB, đồ thị liên kết, văn bản giới thiệu, ảnh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="800" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Nhận bản ghi từ Merger" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Trang có gì&lt;br&gt;mới không?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Không đổi: chỉ ghi lại&lt;br&gt;thời điểm kiểm tra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="155" width="280" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Trang web&lt;br&gt;hay tài liệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="260" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;① Lưu trang web&lt;/b&gt; vào html:&lt;br&gt;tiêu đề, nội dung, ngày đăng, tác giả, ảnh;&lt;br&gt;thêm mới hoặc ghi đè bản cũ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="330" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;① Lưu tài liệu&lt;/b&gt; vào other:&lt;br&gt;nội dung và trang đầu tiên&lt;br&gt;dẫn tới tài liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="380" width="330" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;② Cập nhật đồ thị liên kết&lt;/b&gt; graph:&lt;br&gt;mỗi liên kết là một cạnh nguồn → đích&lt;br&gt;kèm văn bản mô tả" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="330" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;③ Tính văn bản giới thiệu&lt;/b&gt; của trang:&lt;br&gt;gom các câu mà trang khác dùng để&lt;br&gt;dẫn tới nó, bỏ trùng, giữ 20 câu&lt;br&gt;xuất hiện nhiều nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="330" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;④ Ghi nhận ảnh&lt;/b&gt; vào picture: ảnh mới được&lt;br&gt;ghi kèm trang chứa nó, chưa tải về" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="330" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;trang · tài liệu&lt;br&gt;liên kết · ảnh" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E8F5E9;strokeColor=#00684A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="600" width="200" height="130" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="505" y="612" width="40" height="40" as="geometry"/></mxCell><mxCell id="c15" value="Sau khi thu thập xong:&lt;br&gt;tải lần lượt các ảnh chưa tải" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="330" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Tải được ảnh&lt;br&gt;không quá 2 MB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="950" width="200" height="90" as="geometry"/></mxCell><mxCell id="c17" value="Lưu ảnh dạng base64,&lt;br&gt;kèm kích thước, định dạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="960" width="270" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Ghi lý do lỗi như cần đăng&lt;br&gt;nhập, không tồn tại, quá lớn;&lt;br&gt;không thử lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="1040" width="270" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"