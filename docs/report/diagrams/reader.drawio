<mxfile host="drawio" version="26.0.0"><diagram name="reader" id="reader"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Reader: bóc tách trang web và tài liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="800" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Nhận nội dung tải về từ Downloader" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="300" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Loại&lt;br&gt;nội dung?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Trang chưa đổi&lt;/b&gt;:&lt;br&gt;báo thẳng cho Merger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Trang web&lt;/b&gt;: tìm vùng nội&lt;br&gt;dung chính, xem Hình 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Lấy ra: tiêu đề, ngày đăng,&lt;br&gt;tác giả, nội dung, ảnh, các&lt;br&gt;liên kết kèm câu chứa&lt;br&gt;liên kết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Tệp tài liệu&lt;/b&gt;: lưu bản gốc&lt;br&gt;để không phải tải lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="300" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Loại tệp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="385" width="200" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Đọc trực tiếp&lt;/b&gt;&lt;br&gt;PDF: PyMuPDF, tách theo trang&lt;br&gt;Word: python-docx&lt;br&gt;PowerPoint: python-pptx, theo slide&lt;br&gt;Excel: openpyxl, xlrd, theo sheet&lt;br&gt;Văn bản thuần, CSV: đọc thẳng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontSize=14;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="300" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Định dạng cũ: đổi bằng LibreOffice&lt;/b&gt;&lt;br&gt;.doc, .odt, .rtf → .docx&lt;br&gt;.ppt, .odp → .pptx&lt;br&gt;.ods → .xlsx&lt;br&gt;rồi đọc như ô bên trên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="300" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="436" width="30" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Văn bản tách theo từng trang, slide, sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Có trang chỉ có&lt;br&gt;hình, không có chữ,&lt;br&gt;như PDF ảnh quét?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="c16" value="Trang này đã&lt;br&gt;nhận dạng&lt;br&gt;trước đây?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="c17" value="Gửi dịch vụ đám mây&lt;br&gt;&lt;b&gt;LlamaParse&lt;/b&gt; đọc chữ trong&lt;br&gt;ảnh, lưu kết quả dùng lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="200" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Hết hạn mức dịch vụ:&lt;br&gt;giữ phần chữ đã có" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1190" y="655" width="150" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Ghép chữ nhận dạng được&lt;br&gt;vào văn bản, nối các trang lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="790" width="300" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Dấu vân tay nội dung&lt;/b&gt;: mã băm của văn bản, bỏ qua ngày giờ&lt;br&gt;và bộ đếm lượt xem; lần tải sau so mã này để biết&lt;br&gt;trang có thay đổi hay không" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="885" width="520" height="82" as="geometry"/></mxCell><mxCell id="c21" value="Gửi bản ghi sang Merger" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="995" width="360" height="50" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="chưa đổi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="195"/></Array></mxGeometry></mxCell><mxCell id="c24" value="trang web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0.75;exitPerimeter=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="262"/><mxPoint x="170" y="262"/></Array></mxGeometry></mxCell><mxCell id="c25" value="tài liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWid