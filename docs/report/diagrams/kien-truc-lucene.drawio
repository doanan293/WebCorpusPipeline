<mxfile host="drawio" version="26.0.0"><diagram name="lk" id="lk"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lk1" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="lk2" value="Hệ thống tìm kiếm Lucene: lập chỉ mục, đồng bộ và tìm kiếm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="lk3" value="Crawler ghi trang mới,&lt;br&gt;thu thập lại trang cũ" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="56" as="geometry"/></mxCell><mxCell id="lk4" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;trang web · tệp tài liệu&lt;br&gt;đồ thị liên kết" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E8F5E9;strokeColor=#00684A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="210" height="150" as="geometry"/></mxCell><mxCell id="lk5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="117" y="214" width="36" height="36" as="geometry"/></mxCell><mxCell id="lk6" value="&lt;b&gt;Lập chỉ mục toàn bộ&lt;/b&gt;&lt;br&gt;đọc mọi trang, tệp; tách từ;&lt;br&gt;gom văn bản liên kết cho tệp; tính PageRank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="330" height="84" as="geometry"/></mxCell><mxCell id="lk7" value="&lt;b&gt;Đồng bộ tăng dần&lt;/b&gt;&lt;br&gt;chỉ đọc bản ghi mới đổi;&lt;br&gt;thêm, ghi đè, xoá trong chỉ mục" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="330" height="84" as="geometry"/></mxCell><mxCell id="lk8" value="&lt;b&gt;Tính lại PageRank&lt;/b&gt;&lt;br&gt;từ đồ thị liên kết, ghi đè điểm&lt;br&gt;cho mọi tài liệu, không tách từ lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="330" height="84" as="geometry"/></mxCell><mxCell id="lk9" value="&lt;br&gt;&lt;b&gt;Chỉ mục Lucene&lt;/b&gt;&lt;br&gt;chỉ mục ngược cho tiêu đề,&lt;br&gt;văn bản liên kết, nội dung;&lt;br&gt;bản gốc để cắt đoạn trích;&lt;br&gt;điểm PageRank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="750" y="150" width="250" height="170" as="geometry"/></mxCell><mxCell id="lk10" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="857" y="158" width="36" height="36" as="geometry"/></mxCell><mxCell id="lk11" value="Người dùng nhập truy vấn" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="80" width="250" height="56" as="geometry"/></mxCell><mxCell id="lk12" value="&lt;b&gt;Tìm kiếm&lt;/b&gt;&lt;br&gt;dựng truy vấn, mở rộng viết tắt,&lt;br&gt;xếp hạng, ẩn trang trùng, gợi ý chính tả;&lt;br&gt;mở lại chỉ mục khi có thay đổi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="185" width="250" height="110" as="geometry"/></mxCell><mxCell id="lk13" value="Danh sách kết quả: tiêu đề,&lt;br&gt;đường dẫn, đoạn trích tô từ khoá" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="345" width="250" height="64" as="geometry"/></mxCell><mxCell id="lk14" value="ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#6D28D9;" edge="1" parent="1" source="lk3" target="lk4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk15" value="đọc một lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk4" target="lk6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk16" value="đọc định kỳ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk4" target="lk7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk17" value="đọc đồ thị" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk4" target="lk8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk18" value="tạo mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk6" target="lk9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk19" value="cập nhật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk7" target="lk9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk20" value="ghi đè điểm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk8" target="lk9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk21" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lk9" target="lk12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lk11" target="lk12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lk23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;strokeColor=#16A34A;fontColor=#15803D;"