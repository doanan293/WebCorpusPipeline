<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram name="Điều phối, tải và lập lịch thu thập lại" id="dieu-phoi-tai"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Mediator: xếp hàng URL và chia việc tải" style="rounded=1;arcSize=4;dashed=1;html=1;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=16;fontStyle=1;fontFamily=Helvetica;strokeColor=#7C3AED;fontColor=#6D28D9;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="560" height="890" as="geometry"/></mxCell><mxCell id="c3" value="Downloader: tải trang web và tệp tài liệu" style="rounded=1;arcSize=4;dashed=1;html=1;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=16;fontStyle=1;fontFamily=Helvetica;strokeColor=#2563EB;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="600" y="10" width="600" height="700" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="520" y="16" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontFamily=Helvetica;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1155" y="16" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Nhận URL mới từ Merger" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Phân loại URL thành trang chủ, trang mục,&lt;br&gt;trang thường, tài liệu rồi xếp hàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Lấy URL đến lượt. Mỗi website chỉ bị&lt;br&gt;tải 2 URL cùng lúc và phải nghỉ 1 đến&lt;br&gt;5 giây giữa hai lần, tùy nó nhanh hay chậm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="300" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Hỏi lần lượt&lt;br&gt;từng máy tải:&lt;br&gt;đang rảnh không?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Máy bận thì hỏi máy khác;&lt;br&gt;máy không trả lời thì&lt;br&gt;tạm bỏ qua 30 giây" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="330" width="180" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Giao URL cho máy tải" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Máy tải&lt;br&gt;nhận việc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="515" width="200" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Thử lại tối đa 5 lần,&lt;br&gt;sau đó để lần định kỳ sau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="525" width="180" height="60" as="geometry"/></mxCell><mxCell id="c14" value="Hẹn tải lại: trang chủ, trang mục sau 1 ngày;&lt;br&gt;trang thường 7 ngày; tài liệu 30 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Merger báo kết quả mỗi lần tải:&lt;br&gt;trang có thay đổi hay không" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Điều chỉnh lịch tải lại&lt;/b&gt;&lt;br&gt;Trang có thay đổi: tải lại sớm hơn&lt;br&gt;Trang không đổi: thưa dần, tối đa 90 ngày&lt;br&gt;Trang chủ, trang mục: mỗi ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="300" height="110" as="geometry"/></mxCell><mxCell id="c17" value="Trang hay đổi được&lt;br&gt;cập nhật nhanh, trang&lt;br&gt;tĩnh ít bị tải lại" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;align=left;spacingLeft=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="790" width="185" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=